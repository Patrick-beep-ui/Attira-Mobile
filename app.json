{
  "expo": {
    "name": "Attira",
    "slug": "attira-mobile",
    "version": "0.1.0",
    "scheme": "attira",
    "orientation": "portrait",
    "icon": "./assets/attira-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.attiraai.mobile"
    },
    "android": {
      "package": "com.attiraai.mobile"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attira necesita acceder a tus fotos para agregar prendas y tu foto de perfil.",
          "cameraPermission": "Attira necesita la cámara para fotografiar tus prendas."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Attira necesita la cámara para fotografiar tus prendas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Attira usa tu ubicación para personalizar recomendaciones según el clima."
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "platforms": [
      "ios",
      "android"
    ]
  }
}
